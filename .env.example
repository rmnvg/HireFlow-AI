
# PostgreSQL (local Docker Compose)
POSTGRES_DB=hireflow
POSTGRES_USER=hireflow
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://hireflow:replace-with-a-strong-password@db:5432/hireflow
DATABASE_SSL=false
DATABASE_INIT_ON_STARTUP=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Groq job-description analysis
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# Apollo saved-contact search
APOLLO_API_KEY=
APOLLO_CONTACTS_URL=https://api.apollo.io/api/v1/contacts/search
APOLLO_TIMEOUT_SECONDS=20

# Hunar Voice calling
HUNAR_API_KEY=
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1
HUNAR_TIMEOUT_SECONDS=30
PUBLIC_BACKEND_URL=http://localhost:8000

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
