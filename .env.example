
# Supabase PostgreSQL
# For Docker environments without IPv6, copy the Session pooler connection string
# from Supabase Dashboard -> Connect. URL-encode password special characters.
DATABASE_URL=postgresql://YOUR_POOLER_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DATABASE_SSL=true
DATABASE_INIT_ON_STARTUP=true
# Optional migration aid: set this when DATABASE_URL is still a direct Supabase URL.
SUPABASE_POOLER_HOST=

# Backend
FRONTEND_URL=http://localhost:3000

# Groq job-description analysis
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# Apollo saved-contact search
APOLLO_API_KEY=
APOLLO_CONTACTS_URL=https://api.apollo.io/api/v1/contacts/search
APOLLO_TIMEOUT_SECONDS=20

# Hunar Voice calling
HUNAR_API_KEY=
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1
HUNAR_TIMEOUT_SECONDS=30
# Replace with a public HTTPS tunnel/backend URL before initiating Hunar calls.
PUBLIC_BACKEND_URL=http://localhost:8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
